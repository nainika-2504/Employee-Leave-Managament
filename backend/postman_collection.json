{
  "info": {
    "name": "Employee Leave Management System (ELMS) - SRS v1.0",
    "description": "Postman test collection for ELMS Spring Boot REST APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alex.morgan@company.com\",\n  \"password\": \"password\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Users - Get All Users",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "Users - Get Leave Balances for User",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/users/101/balances",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "users", "101", "balances"]
        }
      }
    },
    {
      "name": "Leaves - Get All Leave Applications (Manager)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/leaves?role=MANAGER",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "leaves"],
          "query": [
            { "key": "role", "value": "MANAGER" }
          ]
        }
      }
    },
    {
      "name": "Leaves - Get My Leave Applications (Employee)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/leaves?userId=101&role=EMPLOYEE",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "leaves"],
          "query": [
            { "key": "userId", "value": "101" },
            { "key": "role", "value": "EMPLOYEE" }
          ]
        }
      }
    },
    {
      "name": "Leaves - Submit New Leave Application",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"leaveType\": \"CASUAL\",\n  \"startDate\": \"2026-09-15\",\n  \"endDate\": \"2026-09-16\",\n  \"daysCount\": 2,\n  \"reason\": \"Family emergency\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/leaves?queryUserId=101",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8085",
          "path": ["api", "leaves"],
          "query": [
            { "key": "queryUserId", "value": "101" }
          ]
        }
      }
    },
    {
      "name": "Leaves - Review / Approve Leave Request",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\",\n  \"reviewerComments\": \"Approved by Engineering Lead.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/leaves/LV-1001/review?queryReviewerName=Sarah%20Jenkins",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "leaves", "LV-1001", "review"],
          "query": [
            { "key": "queryReviewerName", "value": "Sarah Jenkins" }
          ]
        }
      }
    }
  ]
}
